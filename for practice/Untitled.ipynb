    "import pandas as pd\n",
    "import matplotlib.pyplot as plt\n",
    "\n",
    "df = pd.DataFrame({\n",
    "    \"Name\": [\"Aman\", \"Ravi\", \"Neha\", \"Priya\"],\n",
    "    \"Marks\": [78, 85, 92, 67]\n",
    "})"
